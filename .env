# The SchoolFlow360 backend. Public values only - this file is committed; put anything secret in a
# git-ignored .env.local instead.

# Base URL the app's httpClient calls. A production build calls the backend directly, so the backend
# must allow the app's origin (https://school-flow-360.web.app) in its CORS configuration.
VITE_API_BASE_URL=https://school-flow-360-jlm-back.onrender.com

# Where the dev server proxies /api to (see vite.config.ts). Not exposed to the browser: it has no
# VITE_ prefix.
API_PROXY_TARGET=https://school-flow-360-jlm-back.onrender.com
