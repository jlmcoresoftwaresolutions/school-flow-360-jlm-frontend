# In development the app calls /api on its own origin and the Vite dev server proxies it to the
# backend (API_PROXY_TARGET in .env), so local work doesn't depend on the backend's CORS allowing
# localhost.
VITE_API_BASE_URL=

# localhost isn't a school's address, so development (and the E2E suite, run on the dev server) uses
# this fixed school.
VITE_TENANT_ID=schoolflow_demo
